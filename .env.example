# Copy to .env. NEVER commit .env to the repository!
# Check the UID/GID on Synology over SSH: id your_username
PUID=1026
PGID=100
TZ=Europe/Warsaw

# Existing shared folder on the NAS (local Synology path)
NAS_SCAN_ROOT=/volume1/ScanToMail
# State directory (SQLite); must be writable by PUID
NAS_STATE_DIR=/volume1/docker/scan-to-email/state

# Fastmail: account username and an app password (not the main account password!)
SMTP_USERNAME=scanner@example.com
SMTP_PASSWORD=INSERT_APP_PASSWORD_HERE
